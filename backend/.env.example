MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_INPUT_COST_PER_1M_TOKENS_USD=0.14
DEEPSEEK_OUTPUT_COST_PER_1M_TOKENS_USD=0.28
DEEPSEEK_THINKING_ENABLED=false
MAX_TOOL_ROUNDS=4
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=false
HYBRID_RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=4
VECTOR_MIN_SIMILARITY=0.50
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_LOCAL_FILES_ONLY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_INPUT_COST_PER_1M_TOKENS_USD=0.75
OPENAI_OUTPUT_COST_PER_1M_TOKENS_USD=4.50
MODEL_REQUEST_TIMEOUT_SECONDS=30
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scrapling crawl runtime
CRAWL_CHECKPOINT_DIR=./data/crawl_checkpoints
CRAWL_LOCAL_STORAGE_DIR=./data/crawl_exports

# Existing site-specific crawler projects managed by this control plane.
ZXXK_CRAWLER_ROOT=
YOUTIKE_CRAWLER_ROOT=
SITE_CRAWLER_MANIFEST_DIR=./site_crawler_manifests
SITE_CRAWLER_RETRY_BASE_DELAY_SECONDS=5

# Alibaba Cloud OSS. Use a least-privilege RAM user or STS credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_DEFAULT_BUCKET=xuefangedufile
OSS_CONTENT_BUCKET=xuefangedu
OSS_REVIEW_BUCKET=xuefang-jiaoyan
OSS_DEFAULT_PUBLIC_BASE_URL=https://xuefangedufile.oss-cn-beijing.aliyuncs.com
OSS_CONTENT_PUBLIC_BASE_URL=https://xuefangedu.oss-cn-beijing.aliyuncs.com
OSS_REVIEW_PUBLIC_BASE_URL=

# MySQL destination for structured crawl records.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_SSL_CA=
